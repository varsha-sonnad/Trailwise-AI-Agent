.env
__pycache__/
*.pyc
.venv/
.pytest_cache/
node_modules/
dist/
logs/
*.log
# Zipped copies of the project (can contain a full .venv)
backend.zip

# UI reference screenshots (local only); keep the README that explains them
frontend/reference/*
!frontend/reference/README.md

# Local-testing debug log folder and the compose override that mounts it (see docker-compose.override.yml)
debug-logs/
docker-compose.override.yml

# Other .env files hold real settings; the committed templates stay tracked
.env.*
!.env.example
!frontend/.env.example

# Personal Claude Code settings (the shared .claude/settings.json stays tracked)
.claude/settings.local.json

# Python tool leftovers: packaging, type-check, lint and coverage output
*.egg-info/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Frontend tool leftovers: local env files, coverage and the Vite cache
*.local
coverage/
.vite/

# OS and editor files
.DS_Store
Thumbs.db
.idea/
.vscode/
