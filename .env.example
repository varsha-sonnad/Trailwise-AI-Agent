# Copy this file to .env and fill in real values. Never commit .env.
# OpenAI (the agent). OPENAI_API_KEY is REQUIRED: the backend will not start without it.
OPENAI_API_KEY=your_openai_api_key
# Model names have no defaults on purpose (they change over time): choose them yourself. The fallback is an optional
# backup used when the main model keeps failing (empty = off). The search model is used by the web_search tool and
# must be a small model that supports OpenAI's built-in web search.
OPENAI_MODEL=your_main_model_name
# OPENAI_FALLBACK_MODEL=your_backup_model_name
OPENAI_SEARCH_MODEL=your_search_model_name
# Optional time limits in seconds (defaults shown): one OpenAI call, one web search attempt, the agent's limit for one
# web_search call (keep it above the search attempt), and one whole chat request.
# OPENAI_TIMEOUT_SECONDS=60
# OPENAI_SEARCH_TIMEOUT_SECONDS=120
# WEB_SEARCH_CALL_TIMEOUT_SECONDS=150
# CHAT_REQUEST_TIMEOUT_SECONDS=180
OPENWEATHER_API_KEY=your_openweather_api_key
REDIS_URL=redis://localhost:6379/0
RAILRADAR_API_KEY=your_railradar_api_key
PARSEBOT_API_KEY=your_parsebot_api_key
SMTP_EMAIL=your_email_id
SMTP_PASSWORD=your_email_password
# Keycloak (login). The admin password is REQUIRED for the keycloak container to start; choose your own.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=choose_a_strong_admin_password
# Optional backend settings (defaults shown): the public Keycloak address, the realm and the token audience.
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=trailwise
# KEYCLOAK_AUDIENCE=trailwise-api
# Optional: where the backend fetches Keycloak's public keys when that differs from KEYCLOAK_URL (in Docker the
# compose file sets this to http://keycloak:8080). Empty = use KEYCLOAK_URL.
# KEYCLOAK_INTERNAL_URL=
# REQUIRED: your MongoDB Atlas connection string. The app will not start without it. In Atlas: Connect > Drivers,
# copy the string (mongodb+srv://... or mongodb://...), put your database user's password in it, and allow your
# IP under Network Access. Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trailwise?retryWrites=true&w=majority
# Geocoding for the geocode_places tool (a Nominatim-style service). GEOCODE_USER_AGENT must identify the app and
# give a real contact (Nominatim's usage policy); replace the example address with your own. The public server
# allows about one request per second, which the tool respects.
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=Trailwise/0.1 (contact: you@example.com)
# Routing for the get_route tool (an OSRM-style service). The public demo server below is for light use only and
# supports driving; for real traffic use your own or a hosted OSRM and put its address here.
ROUTING_BASE_URL=https://router.project-osrm.org
# Photos for the get_place_images tool (Pexels). Both are needed, otherwise the tool reports "not configured".
# The key is sent only in a request header and is never logged. Pexels asks for photographer attribution.
PEXELS_BASE_URL=https://api.pexels.com/v1
PEXELS_API_KEY=your_pexels_api_key
# Optional: SMTP server (defaults match Mailpit). For a real provider use e.g. smtp.gmail.com, port 587, STARTTLS true.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# Optional: the ONE address send_trip_email sends to. Empty = it sends to SMTP_EMAIL itself.
# VERIFIED_RECIPIENT=you@example.com
# Optional audit log of agent activity (default on, file backend/logs/audit.log).
# AUDIT_LOG_ENABLED=true
# AUDIT_LOG_PATH=
# Optional local-testing debug log (both default to false). LOG_MESSAGES only works together with DEBUG_LOG_FILE and
# also writes the start of each question and answer (emails and phone numbers masked).
# DEBUG_LOG_FILE=false
# LOG_MESSAGES=false
