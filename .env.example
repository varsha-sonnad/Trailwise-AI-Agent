# Copy this file to .env and fill in real values. Never commit .env.
OPENWEATHER_API_KEY=your_openweather_api_key
# OpenAI (the agent uses it). Use your own key and choose the
# model names yourself; OPENAI_API_KEY and OPENAI_MODEL are REQUIRED, OPENAI_FALLBACK_MODEL is an optional backup.
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=your-openai-model-name
# OPENAI_FALLBACK_MODEL=your-backup-model-name
# Seconds to wait for one OpenAI call (default 60).
# OPENAI_TIMEOUT_SECONDS=60
# Model for the web_search tool (OpenAI's built-in web search). No default: choose a small model that supports web
# search. Without it web_search answers "not configured". It uses OPENAI_API_KEY above.
OPENAI_SEARCH_MODEL=your-openai-search-model-name
# Time limits (seconds). OPENAI_SEARCH_TIMEOUT_SECONDS: how long ONE web search attempt waits for OpenAI (default 120); a
# timeout is retried once. WEB_SEARCH_CALL_TIMEOUT_SECONDS: the agent's limit for the whole web_search call (default 150); the
# search holds both attempts under it (minus 10 seconds), so keep it above the first setting. CHAT_REQUEST_TIMEOUT_SECONDS:
# one overall cap for a whole chat request (default 180); when it runs out the user gets a friendly "took too long" reply.
# OPENAI_SEARCH_TIMEOUT_SECONDS=120
# WEB_SEARCH_CALL_TIMEOUT_SECONDS=150
# CHAT_REQUEST_TIMEOUT_SECONDS=180
# Redis (cache). OPTIONAL for the MCP tools (geocode_places, get_route): if REDIS_URL is not set they skip the cache
# silently; if it is set but Redis cannot be reached they log one short warning per call and still work. On your own
# computer use redis://localhost:6379/0. Inside Docker the Redis service is called "redis", so use redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
RAILRADAR_API_KEY=your_railradar_api_key
PARSEBOT_API_KEY=your_parsebot_api_key
SMTP_EMAIL=your_email_id
SMTP_PASSWORD=your_email_password
# Keycloak (login). The admin password is REQUIRED for the keycloak container to start; choose your own.
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=choose_a_strong_admin_password
# Optional backend settings (defaults shown): the public Keycloak address, the realm and the token audience.
# KEYCLOAK_URL=http://localhost:8080
# KEYCLOAK_REALM=trailwise
# KEYCLOAK_AUDIENCE=trailwise-api
# REQUIRED: your MongoDB Atlas connection string. The app will not start without it. In Atlas: Connect > Drivers,
# copy the string (mongodb+srv://... or mongodb://...), put your database user's password in it, and allow your
# IP under Network Access. Never commit the real value.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/trailwise?retryWrites=true&w=majority
# Geocoding for the geocode_places tool (a Nominatim-style service). GEOCODE_USER_AGENT must identify the app and
# give a real contact (Nominatim's usage policy); replace the example address with your own. The public server
# allows about one request per second, which the tool respects.
GEOCODE_BASE_URL=https://nominatim.openstreetmap.org
GEOCODE_USER_AGENT=Trailwise/0.1 (contact: you@example.com)
# Routing for the get_route tool (an OSRM-style service). The public demo server below is for light use only and
# supports driving; for real traffic use your own or a hosted OSRM and put its address here.
ROUTING_BASE_URL=https://router.project-osrm.org
# Photos for the get_place_images tool (Pexels). Get a free key at https://www.pexels.com/api/ and replace the
# placeholder; never commit the real key. Photos must be shown with the photographer's credit and a link to Pexels.
PEXELS_BASE_URL=https://api.pexels.com/v1
PEXELS_API_KEY=your-pexels-api-key-here
# Optional: SMTP server (defaults match Mailpit). For a real provider use e.g. smtp.gmail.com, port 587, STARTTLS true.
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_STARTTLS=false
# Optional plain-text debug log for LOCAL TESTING only (both off by default). DEBUG_LOG_FILE=true writes a rotating
# logs/debug.log (in Docker /app/logs/debug.log, mounted on your machine as ./debug-logs by docker-compose.override.yml)
# with REQUEST, TOOL, RESULT and ERROR lines. LOG_MESSAGES=true, only together with it, also writes the first 150
# characters of each question and 300 of each answer (emails and phone numbers masked). The JSON audit log is unchanged.
DEBUG_LOG_FILE=false
LOG_MESSAGES=false
