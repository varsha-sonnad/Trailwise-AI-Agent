# Non-secret settings for the frontend. Copy to .env.local if you need to change a value.
# Never put API keys here: everything in a Vite env file ends up in the browser bundle.

# Where the backend is running (Docker maps your machine's port 8000 to the container).
VITE_API_URL=http://localhost:8000

# Keycloak (login): where it runs, the realm and the client. These are public settings, not secrets.
VITE_KEYCLOAK_URL=http://localhost:8080
VITE_KEYCLOAK_REALM=trailwise
VITE_KEYCLOAK_CLIENT_ID=trailwise-web
