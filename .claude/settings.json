{
  "permissions": {
    "allow": [
      "Bash(pytest *)",
      "Bash(python -m pytest *)",
      "Bash(uvicorn *)",
      "Bash(pip install -r requirements.txt)",
      "Bash(docker compose up *)",
      "Bash(docker compose down)",
      "Bash(docker compose ps)",
      "Bash(docker compose logs *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./backend/.env)",
      "Read(./**/.env.local)",
      "Edit(./.env)",
      "Edit(./backend/.env)",
      "Edit(./**/.env.local)",
      "Bash(rm -rf *)",
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git reset --hard *)",
      "Bash(curl * | *)",
      "Bash(wget * | *)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "python -c \"import sys,json;n=json.load(sys.stdin).get('tool_input',{}).get('file_path','').replace(chr(92),'/').split('/')[-1];bad=n.startswith('.env') and n!='.env.example';bad and sys.stderr.write('Blocked: .env files hold secrets. Edit .env.example instead.');sys.exit(2 if bad else 0)\""
          }
        ]
      }
    ]
  }
}
